{
  "manifestVersion": 1,
  "migrations": "./migrations",
  "output": {
    "ir": "./syncular.ir.json",
    "module": "./src/syncular.generated.ts"
  },
  "schemaVersions": [{ "version": 1, "through": "0001_initial" }],
  "tables": [
    { "name": "organizations", "scopes": ["org:{id}"] },
    { "name": "projects", "scopes": ["org:{org_id}"] },
    { "name": "app_users", "scopes": ["org:{org_id}"] },
    { "name": "project_memberships", "scopes": ["project:{project_id}"] },
    { "name": "tasks", "scopes": ["project:{project_id}"] },
    { "name": "task_blob_entries", "scopes": ["project:{project_id}"] }
  ],
  "subscriptions": [
    {
      "name": "tasksInProjects",
      "table": "tasks",
      "scopes": { "project_id": ["{projectIds}"] }
    }
  ]
}
