{
  "name": "offline-sync-bench",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "scripts": {
    "scenarios": "bun run src/cli.ts list-scenarios",
    "stacks": "bun run src/cli.ts list-stacks",
    "bench:plan": "bun run src/cli.ts plan",
    "bench:run": "bun run src/cli.ts run",
    "bench:all": "bun run src/cli.ts run-all",
    "bench:report": "bun run src/cli.ts report",
    "bench:cleanup": "bun run src/cli.ts cleanup",
    "results:md": "bun run src/public-results.ts",
    "bundle:size": "bun run src/bundle-size.ts",
    "typecheck": "bunx tsc --noEmit",
    "stacks:syncular:config": "docker compose -f stacks/syncular/docker-compose.yml config",
    "stacks:syncular:up": "docker compose -f stacks/syncular/docker-compose.yml up --build -d",
    "stacks:syncular:down": "docker compose -f stacks/syncular/docker-compose.yml down -v --remove-orphans",
    "stacks:electric:config": "docker compose -f stacks/electric/docker-compose.yml config",
    "stacks:electric:up": "docker compose -f stacks/electric/docker-compose.yml up --build -d",
    "stacks:electric:down": "docker compose -f stacks/electric/docker-compose.yml down -v --remove-orphans",
    "stacks:zero:config": "docker compose -f stacks/zero/docker-compose.yml config",
    "stacks:zero:up": "docker compose -f stacks/zero/docker-compose.yml up --build -d",
    "stacks:zero:down": "docker compose -f stacks/zero/docker-compose.yml down -v --remove-orphans",
    "stacks:powersync:config": "docker compose -f stacks/powersync/docker-compose.yml config",
    "stacks:powersync:up": "docker compose -f stacks/powersync/docker-compose.yml up --build -d",
    "stacks:powersync:down": "docker compose -f stacks/powersync/docker-compose.yml down -v --remove-orphans",
    "stacks:turso:config": "docker compose -f stacks/turso/docker-compose.yml config",
    "stacks:turso:up": "docker compose -f stacks/turso/docker-compose.yml up --build -d",
    "stacks:turso:down": "docker compose -f stacks/turso/docker-compose.yml down -v --remove-orphans",
    "stacks:jazz-v2:config": "docker compose -f stacks/jazz-v2/docker-compose.yml config",
    "stacks:jazz-v2:up": "docker compose -f stacks/jazz-v2/docker-compose.yml up --build -d",
    "stacks:jazz-v2:down": "docker compose -f stacks/jazz-v2/docker-compose.yml down -v --remove-orphans",
    "stacks:triplit:config": "docker compose -f stacks/triplit/docker-compose.yml config",
    "stacks:triplit:up": "docker compose -f stacks/triplit/docker-compose.yml up -d",
    "stacks:triplit:down": "docker compose -f stacks/triplit/docker-compose.yml down -v --remove-orphans"
  },
  "dependencies": {
    "@electric-sql/client": "^1.5.18",
    "@syncular/client": "0.15.18",
    "@syncular/core": "0.15.18",
    "@tanstack/db": "0.6.16",
    "@tanstack/electric-db-collection": "0.3.14",
    "@tanstack/node-db-sqlite-persistence": "0.2.8",
    "@tanstack/offline-transactions": "1.0.41",
    "@triplit/cli": "1.0.61",
    "@triplit/client": "1.0.50",
    "@tursodatabase/sync": "0.7.0",
    "@powersync/node": "^0.18.6",
    "@powersync/web": "^1.38.1",
    "@rocicorp/zero": "^1.1.1",
    "better-sqlite3": "^12.6.2",
    "esbuild": "^0.27.3",
    "fake-indexeddb": "^6.2.5",
    "hono": "^4.12.5",
    "jose": "^6.2.0",
    "jazz-tools": "2.0.0-alpha.53",
    "kysely": "^0.28.11",
    "postgres": "^3.4.8"
  },
  "devDependencies": {
    "@journeyapps/wa-sqlite": "^1.7.0",
    "@syncular/server": "0.15.18",
    "@syncular/server-hono": "0.15.18",
    "@types/bun": "^1.3.10",
    "typescript": "^5.9.3"
  }
}
