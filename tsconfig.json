{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@syncular/core": ["../../syncular/packages/core/src/index.ts"],
      "@syncular/server": ["../../syncular/packages/server/src/index.ts"],
      "@syncular/server-hono": [
        "../../syncular/packages/server-hono/src/index.ts"
      ],
      "@syncular/client": ["../../syncular/packages/web-client/src/index.ts"],
      "@syncular/client/bun": [
        "../../syncular/packages/web-client/src/bun-database.ts"
      ]
    },
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "services/bench-admin/src/**/*.ts",
    "services/livestore-bench-app/src/**/*.ts",
    "services/replicache-bench-app/src/**/*.ts",
    "stacks/syncular/syncular-app/src/**/*.ts",
    "services/zero-bench-app/src/**/*.ts",
    "services/powersync-bench-app/src/**/*.ts"
  ]
}
